{
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": [ "@playwright/test" ]
  },
  "include": [ "tests/**/*.ts", "src/**/*.ts", "playwright.config.ts" ]
}
